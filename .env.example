# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Used by both stack.yml (development) and stack.prod.yml (production).

# Postgres superuser password. Both stacks connect to Postgres as the
# `postgres` superuser (see the note at the bottom of this file). Generate
# one with: openssl rand -hex 32
POSTGRES_PASSWORD=changeme-generate-with-openssl-rand-hex-32

# Rails' secret_key_base in production — signs/encrypts sessions, cookies,
# and other signed data. Required by stack.prod.yml's web and worker
# services. Generate one with: openssl rand -hex 64
SECRET_KEY_BASE=changeme-generate-with-openssl-rand-hex-64

# Stripe secret API key for server-side charges/webhooks. From the Stripe
# Dashboard → Developers → API keys (use a test key for development, a
# live key only in production, never the same key in both).
STRIPE_SECRET_KEY=sk_test_changeme

# Signing secret for verifying Stripe webhook payloads. From the Stripe
# Dashboard → Developers → Webhooks → select your endpoint → Signing secret
# (or `stripe listen` output when testing locally with the Stripe CLI).
STRIPE_WEBHOOK_SECRET=whsec_changeme

# Base URL the Rails app uses to build links back to the frontend (emails,
# redirects, CORS). Point this at the frontend host for the environment
# you're running: e.g. http://eventberlin.binary for LAN dev, or
# https://eventberlin.kancodes.de for production.
FRONTEND_URL=http://eventberlin.binary

# Base URL the Next.js frontend calls for the Rails API. IMPORTANT: Next.js
# inlines NEXT_PUBLIC_* variables into the client bundle at BUILD time, not
# at container start — for stack.prod.yml this must also be passed as a
# `build.args` value (already wired up), not only as a runtime environment
# entry, or the compiled bundle will keep pointing at the wrong API.
NEXT_PUBLIC_API_URL=https://api.eventberlin.kancodes.de/api/v1

# ------------------------------------------------------------------------
# Known and deferred: the Rails app currently connects to Postgres as the
# `postgres` superuser in both stacks (POSTGRES_USER: postgres in
# stack.yml / stack.prod.yml, matching DATABASE_URL). This is more
# privilege than the application needs. A follow-up should create a
# dedicated Postgres role scoped to only the application database
# (event_berlin_development / event_berlin_production) and switch
# POSTGRES_USER / DATABASE_URL over to it. Not fixed here — flagging so it
# isn't mistaken for reviewed and accepted.
# ------------------------------------------------------------------------

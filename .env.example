# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Used by both stack.yml (development) and stack.prod.yml (production).

# Postgres superuser password. Both stacks connect to Postgres as the
# `postgres` superuser (see the note at the bottom of this file). Generate
# one with: openssl rand -hex 32
POSTGRES_PASSWORD=changeme-generate-with-openssl-rand-hex-32

# Rails' secret_key_base in production — signs/encrypts sessions, cookies,
# and other signed data. Required by stack.prod.yml's web and worker
# services. Generate one with: openssl rand -hex 64
SECRET_KEY_BASE=changeme-generate-with-openssl-rand-hex-64

# Decrypts config/credentials.yml.enc (config.require_master_key = true in
# config/environments/production.rb makes Rails check this unconditionally
# at boot, independent of SECRET_KEY_BASE above). config/master.key is NOT
# committed to this repo, so the value must come from wherever that key was
# originally generated/stored (e.g. a password manager, a teammate's local
# copy, your deploy secrets store). Required by stack.prod.yml's web and
# worker services.
#
# If the original master.key has been lost, the existing
# config/credentials.yml.enc cannot be decrypted or recovered — there is no
# way to derive the key from the encrypted file. In that case the fix is to
# regenerate credentials from scratch: delete config/credentials.yml.enc and
# run `bin/rails credentials:edit`, which creates a brand new master key
# (written to config/master.key) and a fresh encrypted credentials file. Any
# secrets that were stored in the old credentials file will need to be
# re-added by hand.
RAILS_MASTER_KEY=changeme-see-comment-above

# Stripe secret API key for server-side charges/webhooks. From the Stripe
# Dashboard → Developers → API keys (use a test key for development, a
# live key only in production, never the same key in both). Required by
# stack.prod.yml's web and worker services; optional in stack.yml (dev) —
# left blank, Stripe checkout/webhook code paths are simply inert.
STRIPE_SECRET_KEY=sk_test_changeme

# Signing secret for verifying Stripe webhook payloads. From the Stripe
# Dashboard → Developers → Webhooks → select your endpoint → Signing secret
# (or `stripe listen` output when testing locally with the Stripe CLI).
# Required by stack.prod.yml's web and worker services; optional in
# stack.yml (dev).
STRIPE_WEBHOOK_SECRET=whsec_changeme

# Base URL the Rails app uses to build links back to the frontend (emails,
# Stripe checkout redirects, mailer links). Point this at the frontend host
# for the environment you're running: e.g. http://eventberlin.binary for
# LAN dev, or https://eventberlin.kancodes.de for production. Required by
# stack.prod.yml's web and worker services — a wrong value here sends
# buyers and email links to the wrong host. Defaults to
# http://eventberlin.binary in stack.yml (dev) if unset.
FRONTEND_URL=http://eventberlin.binary

# Base URL the Next.js frontend calls for the Rails API. IMPORTANT: Next.js
# inlines NEXT_PUBLIC_* variables into the client bundle at BUILD time, not
# at container start — for stack.prod.yml this must also be passed as a
# `build.args` value (already wired up), not only as a runtime environment
# entry, or the compiled bundle will keep pointing at the wrong API.
NEXT_PUBLIC_API_URL=https://api.eventberlin.kancodes.de/api/v1

# Signs and verifies devise-jwt authentication tokens. Read unconditionally
# at boot in production/staging (no default), so the app cannot start
# without it — same failure mode as RAILS_MASTER_KEY. Generate one with:
# bin/rails secret. Required by stack.prod.yml's web and worker services;
# stack.yml (dev) falls back to a placeholder value that is NOT a real
# secret and must never be trusted outside local development.
DEVISE_JWT_SECRET_KEY=changeme-generate-with-bin-rails-secret

# Comma-separated list of allowed CORS origins for the Rails API. Must
# include the public frontend origin or the frontend will be blocked from
# calling its own API, e.g. https://eventberlin.kancodes.de in production.
# Required by stack.prod.yml's web and worker services; stack.yml (dev)
# defaults to the LAN dev frontend origins.
CORS_ORIGINS=https://eventberlin.kancodes.de

# SendGrid API key used as the SMTP password for outbound mail (ticket
# confirmations, etc). From the SendGrid dashboard → Settings → API Keys.
# Defaults to an empty string in code, which fails SMTP auth silently at
# send time rather than at boot. Required by stack.prod.yml's web and
# worker services; optional in stack.yml (dev).
SENDGRID_API_KEY=SG.changeme

# Domain used in the SMTP HELO/EHLO handshake and defaulted mailer links.
# Defaults to events-berlin.de in code, which may not be a domain you
# control. Required by stack.prod.yml's web and worker services; stack.yml
# (dev) defaults to eventberlin.binary.
MAILER_DOMAIN=eventberlin.kancodes.de

# ------------------------------------------------------------------------
# Known and deferred: the Rails app currently connects to Postgres as the
# `postgres` superuser in both stacks (POSTGRES_USER: postgres in
# stack.yml / stack.prod.yml, matching DATABASE_URL). This is more
# privilege than the application needs. A follow-up should create a
# dedicated Postgres role scoped to only the application database
# (event_berlin_development / event_berlin_production) and switch
# POSTGRES_USER / DATABASE_URL over to it. Not fixed here — flagging so it
# isn't mistaken for reviewed and accepted.
# ------------------------------------------------------------------------


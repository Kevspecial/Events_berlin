<%# app/views/booking_mailer/confirmation.html.erb %>
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: -apple-system, sans-serif; color: #1a1a1a; margin: 0; padding: 0; }
    .container { max-width: 600px; margin: 40px auto; padding: 0 24px; }
    .header { background: #000; color: #fff; padding: 32px 24px; border-radius: 12px 12px 0 0; }
    .body { background: #fff; border: 1px solid #e5e5e5; border-top: none; padding: 32px 24px; border-radius: 0 0 12px 12px; }
    .detail { margin: 8px 0; }
    .label { font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; }
    .value { font-size: 16px; font-weight: 600; margin-top: 2px; }
    .footer { text-align: center; color: #9ca3af; font-size: 12px; margin-top: 24px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1 style="margin:0;font-size:24px;">Booking Confirmed</h1>
      <p style="margin:8px 0 0;opacity:0.8;">You're going to <%= @event.name %>!</p>
    </div>
    <div class="body">
      <p>Hi <%= @user.email %>,</p>
      <p>Your booking has been confirmed. Here are your details:</p>

      <div class="detail">
        <div class="label">Event</div>
        <div class="value"><%= @event.name %></div>
      </div>
      <div class="detail">
        <div class="label">Date</div>
        <div class="value"><%= @event.date&.strftime('%A, %B %-d, %Y at %H:%M') %></div>
      </div>
      <div class="detail">
        <div class="label">Location</div>
        <div class="value"><%= @event.location %></div>
      </div>
      <div class="detail">
        <div class="label">Booking Reference</div>
        <div class="value">#<%= @booking.id %></div>
      </div>
      <div class="detail">
        <div class="label">Status</div>
        <div class="value"><%= @booking.status.capitalize %></div>
      </div>

      <p style="margin-top:24px;">See you there!</p>
      <p>The Events Berlin Team</p>
    </div>
    <div class="footer">Events Berlin &middot; Berlin, Germany</div>
  </div>
</body>
</html>
